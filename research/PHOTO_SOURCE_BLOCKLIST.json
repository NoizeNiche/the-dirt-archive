{
  "version": 1,
  "purpose": "High-confidence non-product image source policy for The Dirt Archive photo recovery.",
  "rules": [
    {
      "type": "exact_url",
      "pattern": "https://files.effectsdatabase.com/graphics/buymeacoffee.png",
      "reason": "Effects Database donation graphic, not a pedal photograph.",
      "severity": "hard_block"
    },
    {
      "type": "url_regex",
      "pattern": "(?:buymeacoffee|patreon|ko[-_ ]?fi|paypal(?:\\.me|\\.com)?|cash\\.app|venmo|donat(?:e|ion)|sponsor(?:ship)?|checkout|payment)",
      "reason": "Donation, payment, or support asset rather than an exact pedal photograph.",
      "severity": "hard_block"
    },
    {
      "type": "basename_regex",
      "pattern": "(?:^|[-_.])(logo|favicon|sprite|avatar|badge|icon|social|banner|widget|placeholder|spinner)(?:[-_.]|$)",
      "reason": "Generic site artwork or UI asset, not an exact pedal photograph.",
      "severity": "hard_block"
    },
    {
      "type": "url_regex",
      "pattern": "files\\.effectsdatabase\\.com/(?:brands/thumbs|graphics/google-preferred-source)",
      "reason": "Effects Database brand/default artwork, not an exact pedal photograph.",
      "severity": "hard_block"
    },
    {
      "type": "url_regex",
      "pattern": "static\\.reverb-assets\\.com/.*(?:shop-brand-default|brand-default)",
      "reason": "Reverb generic shop/brand default artwork, not an exact pedal photograph.",
      "severity": "hard_block"
    },
    {
      "type": "url_regex",
